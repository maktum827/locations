{
  "name": "@noholi/locations",
  "version": "1.0.1",
  "description": "Reusable geographic location data for Noholi applications and other JavaScript/TypeScript projects.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
